rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOwnProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function protectedProfileFieldsUnchanged() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'active', 'createdAt']);
    }

    match /users/{uid} {
      allow get: if isOwnProfile(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if (isOwnProfile(uid) || isAdmin())
        && protectedProfileFieldsUnchanged();
      allow delete: if false;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
